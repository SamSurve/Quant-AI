# ==============================================================================
# QuantAI Finance Agent — Environment Configuration Template
# ==============================================================================
# All financial market data, fundamental statements, balance sheets, cash flows,
# price charts, quote metrics, peer comparisons, and entity search operate
# deterministically via Yahoo Finance without requiring any external AI API keys.
#
# AI-powered analyst synthesis, deep narratives, and comparative evaluations are
# optional and enhance the deterministic data when configured.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Runtime Configuration (Local Development & Self-Hosted)
# ------------------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
# ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Primary AI Provider — Groq (Optional)
# ------------------------------------------------------------------------------
# Used for fast, structured financial analysis and market synthesis.
# Default model: openai/gpt-oss-120b
GROQ_API_KEY_PRIMARY=
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# Secondary AI Provider — Groq Fallback (Optional)
# ------------------------------------------------------------------------------
# Secondary credential used if primary hits rate limits or transient errors.
GROQ_API_KEY_SECONDARY=
GROQ_MODEL_SECONDARY=openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# Tertiary AI Provider — OpenRouter (Optional)
# ------------------------------------------------------------------------------
# Fallback provider used if all Groq attempts are exhausted or unavailable.
# Default model: stealth/ox-alpha
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stealth/ox-alpha

# ------------------------------------------------------------------------------
# Provider Execution Strategy & Order (Optional)
# ------------------------------------------------------------------------------
# Comma-separated list defining provider fallback order.
# Must be a permutation of: groq_primary,groq_secondary,openrouter_ox_alpha
AI_PROVIDER_ORDER=groq_primary,groq_secondary,openrouter_ox_alpha
